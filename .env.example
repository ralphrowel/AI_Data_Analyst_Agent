APP_ENV=production
ALLOW_DEMO_AUTH=false
# Production Database (Supabase PostgreSQL transaction pooler or direct connection)
DATABASE_URL=postgresql+psycopg://postgres.xxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Auth configuration
SUPABASE_URL=https://your-project.supabase.co
# Leave empty for asymmetric JWKS verification. Set only for legacy HS256 projects.
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=your-anon-key

# Supabase Storage (production persistent file uploads)
# Service role key (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=visiq-uploads

# Quota & Upload limits
DAILY_TOKEN_LIMIT=50000
MAX_UPLOAD_BYTES=5242880

# LLM Providers & Keys
GROQ_API_KEY=
GEMINI_API_KEY=
# Second Gemini key for automatic quota rotation (use a different Google account)
GEMINI_API_KEY_2=
DEFAULT_LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
USE_LEGACY_AGENT=false

# CORS Configuration (Railway backend)
# Comma-separated allowed frontend origins. By default, any *.vercel.app domain is allowed automatically via regex.
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

